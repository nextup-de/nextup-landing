# Copy to .env.local for local development - never commit .env.local.
# On the server these go in ~/nextup/landing/.env (deploy/README.md).

# Where /login sends people: each company's own NextUp, {slug} = the company. Server-side.
# Default https://{slug}.sellux.ch. A laptop stack serves one company, e.g.:
# COMPANY_URL=http://localhost:8080

# Where the /contact form forwards a pilot request: the app's intake endpoint, and the shared
# token the app expects (same value as PILOT_INTAKE_TOKEN in the app). Generate one with
#   openssl rand -hex 32
# Leave both unset and the form opens the visitor's mail program instead.
PILOT_INTAKE_URL=http://localhost:3000/api/pilot-requests
PILOT_INTAKE_TOKEN=
