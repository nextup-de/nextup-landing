# Copy to .env.local for local development - never commit .env.local.
# On the server these go in ~/nextup/landing/.env (deploy/README.md).

# Where /login sends people: each company's own NextUp, {slug} = the company. Server-side.
# Default https://{slug}.sellux.ch. A laptop stack serves one company, e.g.:
# COMPANY_URL=http://localhost:8080
# The companies /login lists (admin's GET /api/directory). Empty = no list, typing only.
# COMPANY_DIRECTORY_URL=http://localhost:3131/api/directory

# Where the /contact form forwards a pilot request: the dev admin's intake endpoint
# (nextup-de/nextup-admin; on the box https://admin.sellux.ch/api/pilot-requests), and the token
# it expects. Admin keeps only its sha256 (PILOT_INTAKE_TOKEN_SHA256). Generate one with
#   openssl rand -hex 32
# Leave both unset and the form opens the visitor's mail program instead.
PILOT_INTAKE_URL=http://localhost:3131/api/pilot-requests
PILOT_INTAKE_TOKEN=
